# ─────────────────────────────────────────────────────────────────────────────
# Everything here is PUBLIC. It ships in the browser bundle, which is what
# NEXT_PUBLIC_ means, and that is correct for all of it:
#
#   * The Firebase WEB config is publishable by design. It identifies the
#     project; it does not authorise anything. Access is decided by Firebase
#     Auth and by our backend verifying the ID token.
#   * The API base URL is the address of a public API.
#
# ⚠️ Never add anything else here. A model provider key, a service account, a
# database URL — those are the backend's, and NEXT_PUBLIC_ would publish them to
# every visitor. There is no server-side secret in this application.
# ─────────────────────────────────────────────────────────────────────────────

# Where the console API lives. http://localhost:8080 for a local backend.
NEXT_PUBLIC_API_BASE_URL=https://drovi-backend.onrender.com

# Firebase console → Project settings → Your apps → Web app → SDK setup.
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyAMJTG-KGee_vRbq1ujIAk87trkKlkjBQ4
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=drovii.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=drovii
NEXT_PUBLIC_FIREBASE_APP_ID=1:354728677387:web:3eb2aa9dc54ff228ee370e
