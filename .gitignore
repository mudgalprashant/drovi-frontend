# --- environment ---
# Everything the console reads is NEXT_PUBLIC_ and therefore public, but a local
# .env still holds one project's configuration and does not belong in git.
.env
.env.*
!.env.example

# --- next / node ---
node_modules/
.next/
out/
next-env.d.ts
*.tsbuildinfo
.eslintcache
npm-debug.log*
yarn-error.log*

# --- credentials: NEVER commit ---
# There is no server-side secret in this application, and that is worth keeping
# true. A service-account file appearing here means something has gone wrong.
service-account*.json
*.pem
*.p12

# --- os / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/

# --- firebase ---
.firebase/
firebase-debug.log
.firebaserc
